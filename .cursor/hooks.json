{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"D:/projects/agenttrace/dist/hook/index.js\" --agenttrace-hook",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"D:/projects/agenttrace/dist/hook/index.js\" --agenttrace-hook",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"D:/projects/agenttrace/dist/hook/index.js\" --agenttrace-hook",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node \"D:/projects/agenttrace/dist/hook/index.js\" --agenttrace-hook",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node \"D:/projects/agenttrace/dist/hook/index.js\" --agenttrace-hook",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "node \"D:/projects/agenttrace/dist/hook/index.js\" --agenttrace-hook",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node \"D:/projects/agenttrace/dist/hook/index.js\" --agenttrace-hook",
        "timeout": 10
      }
    ],
    "afterAgentThought": [
      {
        "command": "node \"D:/projects/agenttrace/dist/hook/index.js\" --agenttrace-hook",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "node \"D:/projects/agenttrace/dist/hook/index.js\" --agenttrace-hook",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node \"D:/projects/agenttrace/dist/hook/index.js\" --agenttrace-hook",
        "timeout": 10
      }
    ]
  }
}
